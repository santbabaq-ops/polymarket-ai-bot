# Wallet Configuration (required)
POLYGON_WALLET_PRIVATE_KEY=0x...  # Your 64-character private key (with or without 0x prefix)

# API Keys
ANTHROPIC_API_KEY=sk-ant-...  # Required for AI strategy
POLYMARKET_API_KEY=...  # Optional - will be auto-generated from private key

# Configuration (optional - can also be set in config.yaml)
STRATEGY_TYPE=ai  # ai, ml, custom
SCAN_INTERVAL=30
MAX_POSITION_SIZE=100
STOP_LOSS=0.02
TAKE_PROFIT=0.05
POLYGON_RPC_URL=https://polygon-rpc.com

# Risk Management
KELLY_FRACTION=0.25
MAX_DAILY_LOSS=0.10
